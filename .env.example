# Clé secrète Flask - À modifier en production
SECRET_KEY=your-secure-secret-key-here

# Configuration Flask
FLASK_ENV=production

# Port (optionnel, défaut 5000)
# FLASK_PORT=5000


# Emergency recovery switch: bypasses the auth guard. Keep false; use only to recover a locked OIDC setup.
BULLARR_AUTH_BYPASS_LOGIN=false
